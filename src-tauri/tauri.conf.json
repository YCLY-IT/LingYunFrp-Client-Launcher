{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "凌云FRP",
  "version": "1.1.3",
  "identifier": "cn.lyfrp.client",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "凌云FRP",
        "width": 1300,
        "height": 620,
        "decorations": false,
        "fullscreen": false,
        "resizable": true,
        "visible": true
      },
      {
        "label": "tray_menu",
        "title": "",
        "url": "#/tray-menu",
        "width": 260,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "Utility",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "compression": "lzma",
        "languages": ["SimpChinese", "TradChinese", "English", "Japanese"],
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "host": "lingyunfrp" }],
      "desktop": {
        "schemes": ["lingyunfrp"]
      }
    }
  }
}
